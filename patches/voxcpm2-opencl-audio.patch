--- /dev/null
+++ b/ggml/src/ggml-opencl/kernels/voxcpm_audio.cl
@@ -0,0 +1,68 @@
+
+// F32 contiguous paths used by VoxCPM2 AudioVAE. No host computation.
+kernel void kernel_voxcpm_sin(global const float *x, ulong xo,
+                              global float *y, ulong yo, int n, int mode) {
+    size_t i = get_global_id(0);
+    if (i < n) {
+        x = (global const float *)((global const char *)x + xo);
+        y = (global float *)((global char *)y + yo);
+        float v = x[i];
+        switch (mode) {
+            case 0: y[i] = sin(v); break;
+            case 1: y[i] = cos(v); break;
+            case 2: y[i] = fabs(v); break;
+            case 3: y[i] = v > 0.0f ? 1.0f : 0.0f; break;
+            case 4: y[i] = round(v); break;
+        }
+    }
+}
+kernel void kernel_voxcpm_arange(global float *y, ulong yo, int n, float start, float step) {
+    size_t i = get_global_id(0);
+    if (i < n) {
+        y = (global float *)((global char *)y + yo);
+        y[i] = start + step * (float)i;
+    }
+}
+// Weights [kernel, Cout, Cin], input [time, Cin], output [time_out, Cout].
+// One work item owns one output; gather avoids floating-point atomics.
+kernel void kernel_voxcpm_conv_transpose(global const float *w, ulong wo,
+                                         global const float *x, ulong xo,
+                                         global float *y, ulong yo,
+                                         int ksize, int cout, int cin,
+                                         int tin, int tout, int stride) {
+    int t = get_global_id(0);
+    int co = get_global_id(1);
+    if (t >= tout || co >= cout) return;
+    w = (global const float *)((global const char *)w + wo);
+    x = (global const float *)((global const char *)x + xo);
+    y = (global float *)((global char *)y + yo);
+    float value = 0.0f;
+    // Only kernel positions with the same remainder as t can contribute.
+    for (int k = t % stride; k < ksize; k += stride) {
+        int ti = (t-k)/stride;
+        if (ti < 0 || ti >= tin || t < k) continue;
+        float dot = 0.0f;
+        for (int ci = 0; ci < cin; ++ci) {
+            dot += x[ti + tin*ci] * w[k + ksize*(co + cout*ci)];
+        }
+        value += dot;
+    }
+    y[t + tout*co] = value;
+}
+
+kernel void kernel_voxcpm_sum(global const float *x, ulong xo,
+                              global float *y, ulong yo, int n) {
+    x = (global const float *)((global const char *)x + xo);
+    y = (global float *)((global char *)y + yo);
+    local float partial[256];
+    int lid = get_local_id(0);
+    float acc = 0.0f;
+    for (int i = lid; i < n; i += 256) acc += x[i];
+    partial[lid] = acc;
+    barrier(CLK_LOCAL_MEM_FENCE);
+    for (int offset = 128; offset > 0; offset /= 2) {
+        if (lid < offset) partial[lid] += partial[lid+offset];
+        barrier(CLK_LOCAL_MEM_FENCE);
+    }
+    if (lid == 0) y[0] = partial[0];
+}
