+static void ggml_cl_voxcpm_audio(ggml_backend_t backend, ggml_tensor * dst) {
+    auto * ctx = (ggml_backend_opencl_context *) backend->context;
+    auto * ed = (ggml_tensor_extra_cl *) dst->extra;
+    const cl_ulong od = ed->offset + dst->view_offs;
+    const int n = (int) ggml_nelements(dst);
+    cl_kernel kernel;
+    if (dst->op == GGML_OP_ARANGE) {
+        kernel = ctx->kernel_voxcpm_arange;
+        const float start = ggml_get_op_params_f32(dst, 0);
+        const float step = ggml_get_op_params_f32(dst, 2);
+        CL_CHECK(clSetKernelArg(kernel, 0, sizeof(cl_mem), &ed->data_device));
+        CL_CHECK(clSetKernelArg(kernel, 1, sizeof(cl_ulong), &od));
+        CL_CHECK(clSetKernelArg(kernel, 2, sizeof(int), &n));
+        CL_CHECK(clSetKernelArg(kernel, 3, sizeof(float), &start));
+        CL_CHECK(clSetKernelArg(kernel, 4, sizeof(float), &step));
+    } else {
+        auto * e0 = (ggml_tensor_extra_cl *) dst->src[0]->extra;
+        const cl_ulong o0 = e0->offset + dst->src[0]->view_offs;
+        if (dst->op == GGML_OP_SIN || dst->op == GGML_OP_COS || dst->op == GGML_OP_SUM || dst->op == GGML_OP_UNARY) {
+            kernel = ctx->kernel_voxcpm_sin;
+            CL_CHECK(clSetKernelArg(kernel, 0, sizeof(cl_mem), &e0->data_device));
+            CL_CHECK(clSetKernelArg(kernel, 1, sizeof(cl_ulong), &o0));
+            CL_CHECK(clSetKernelArg(kernel, 2, sizeof(cl_mem), &ed->data_device));
+            CL_CHECK(clSetKernelArg(kernel, 3, sizeof(cl_ulong), &od));
+            const int input_n = (int) ggml_nelements(dst->src[0]);
+            if (dst->op == GGML_OP_SUM) {
+                kernel = ctx->kernel_voxcpm_sum;
+                CL_CHECK(clSetKernelArg(kernel, 0, sizeof(cl_mem), &e0->data_device));
+                CL_CHECK(clSetKernelArg(kernel, 1, sizeof(cl_ulong), &o0));
+                CL_CHECK(clSetKernelArg(kernel, 2, sizeof(cl_mem), &ed->data_device));
+                CL_CHECK(clSetKernelArg(kernel, 3, sizeof(cl_ulong), &od));
+                CL_CHECK(clSetKernelArg(kernel, 4, sizeof(int), &input_n));
+                size_t global[] = {256}, local[] = {256};
+                ctx->enqueue_ndrange_kernel(kernel, 1, global, local, dst);
+                return;
+            }
+            int mode = dst->op == GGML_OP_COS ? 1 : 0;
+            if (dst->op == GGML_OP_UNARY) {
+                switch (ggml_get_unary_op(dst)) {
+                    case GGML_UNARY_OP_ABS: mode = 2; break;
+                    case GGML_UNARY_OP_STEP: mode = 3; break;
+                    case GGML_UNARY_OP_ROUND: mode = 4; break;
+                    default: GGML_ABORT("unsupported local unary op");
+                }
+            }
+            CL_CHECK(clSetKernelArg(kernel, 5, sizeof(int), &mode));
+            CL_CHECK(clSetKernelArg(kernel, 4, sizeof(int), &n));
+        } else {
+            auto * e1 = (ggml_tensor_extra_cl *) dst->src[1]->extra;
+            const cl_ulong o1 = e1->offset + dst->src[1]->view_offs;
+            kernel = ctx->kernel_voxcpm_conv_transpose;
+            CL_CHECK(clSetKernelArg(kernel, 0, sizeof(cl_mem), &e0->data_device));
+            CL_CHECK(clSetKernelArg(kernel, 1, sizeof(cl_ulong), &o0));
+            CL_CHECK(clSetKernelArg(kernel, 2, sizeof(cl_mem), &e1->data_device));
+            CL_CHECK(clSetKernelArg(kernel, 3, sizeof(cl_ulong), &o1));
+            CL_CHECK(clSetKernelArg(kernel, 4, sizeof(cl_mem), &ed->data_device));
+            CL_CHECK(clSetKernelArg(kernel, 5, sizeof(cl_ulong), &od));
+            const int dims[] = {(int) dst->src[0]->ne[0], (int) dst->src[0]->ne[1],
+                                (int) dst->src[0]->ne[2], (int) dst->src[1]->ne[0],
+                                (int) dst->ne[0], dst->op_params[0]};
+            for (int i = 0; i < 6; ++i) {
+                CL_CHECK(clSetKernelArg(kernel, 6+i, sizeof(int), &dims[i]));
+            }
+            size_t global[] = {(size_t) dst->ne[0], (size_t) dst->ne[1]};
+            ctx->enqueue_ndrange_kernel(kernel, 2, global, nullptr, dst);
+            return;
+        }
+    }
+    size_t global[] = {(size_t) n};
+    ctx->enqueue_ndrange_kernel(kernel, 1, global, nullptr, dst);
+}
